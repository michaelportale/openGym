{
  "expo": {
    "name": "openGym",
    "slug": "opengym",
    "scheme": "opengym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.michaelportale.opengym"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161B20"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthUpdateUsageDescription": "openGym saves your finished workouts and weigh-ins to Apple Health.",
          "NSHealthShareUsageDescription": "openGym reads your body weight from Apple Health for your weight trend."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
